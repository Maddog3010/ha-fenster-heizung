# /etc/stats/stats.env  (Rechte: chmod 600, Besitzer root)
# Datenbank
STATS_DB=/var/lib/stats/stats.db
# Kennungen ohne Meldung werden nach so vielen Tagen gelöscht
RETENTION_DAYS=180

# Eingang: nur vom Cloudflare Tunnel (läuft im selben Container) erreichbar
INGEST_HOST=127.0.0.1
INGEST_PORT=8081

# Dashboard: LAN-IP des Containers eintragen (nicht 0.0.0.0, damit es nur im Heimnetz hört)
DASH_HOST=192.168.1.50
DASH_PORT=8443
DASH_USER=admin
# erzeugen mit:  python3 /opt/stats/server.py hash
DASH_PASS_HASH=

# Optional: HTTPS im Heimnetz (selbst signiertes Zertifikat, siehe README)
#TLS_CERT=/etc/stats/cert.pem
#TLS_KEY=/etc/stats/key.pem
